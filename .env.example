# Optional. When set, Claude writes the questions. Without it, the offline generator is used.
ANTHROPIC_API_KEY=
# Optional. Postgres connection string (for example from Neon). When set, data is stored there.
# Vercel's Neon integration sets this for you. Without it, data goes to a JSON file in DATA_DIR.
DATABASE_URL=
# Optional. Where data is stored when there's no database (JSON file). Defaults to ./data
DATA_DIR=
# Optional. Real payments via Stripe Checkout. Without these, the shop runs a
# clearly labelled demo checkout that grants purchases without charging.
STRIPE_SECRET_KEY=
# For monthly Pro renewals: point a Stripe webhook at /api/billing/webhook
# (events: invoice.paid, customer.subscription.deleted) and paste its secret here.
STRIPE_WEBHOOK_SECRET=
# Public URL of the app, used for Stripe's return links (defaults to the request host).
APP_URL=
